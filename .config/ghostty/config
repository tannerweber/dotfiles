# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
# Ghostty's website, at https://ghostty.org/docs/config.

theme = Paul Millr
font-family = Hack Nerd Font
window-padding-x = 10
window-padding-y = 10
unfocused-split-opacity = 0.95
cursor-opacity = 1.0
cursor-color = #FFFFFF
gtk-titlebar-style = tabs
mouse-hide-while-typing = true
background-image = ~/.rice/wallpapers/gradient_1920x1080.png
background-image-fit = cover


keybind = alt+q=close_tab:this
keybind = alt+t=new_tab
keybind = alt+c=new_tab

keybind = alt+z=toggle_split_zoom
keybind = alt+m=toggle_command_palette
keybind = alt+f=start_search
keybind = alt+enter=toggle_fullscreen

keybind = alt+w=new_split:right
keybind = alt+%=new_split:right
keybind = alt+"=new_split:up

keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

keybind = alt+n=scroll_page_down
keybind = alt+p=scroll_page_up
